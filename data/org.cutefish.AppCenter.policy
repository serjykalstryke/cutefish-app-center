<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Cutefish App Center contributors</vendor>
  <action id="org.cutefish.app-center.manage-debian-sources">
    <description>Change Debian release sources</description>
    <message>Authentication is required to change Debian’s operating-system repositories.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/cutefish-app-center/debian_sources_helper.py</annotate>
  </action>
</policyconfig>
